# Copy to .env. Pre-create CONFIG_DATA owned by PUID:PGID with mode 0700.
PORT=8888
BIND_ADDRESS=127.0.0.1
CONFIG_DATA=./data
CONTAINER_NAME=timeboardapp
TZ=America/Denver
PUID=1000
PGID=1000
# Required for reset links and the ChatGPT schema. Use your application origin,
# not the static project website. HTTPS enables Secure session cookies.
TIMEBOARDAPP_BASE_URL=
