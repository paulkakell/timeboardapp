# Copy to .env. Pre-create CONFIG_DATA owned by PUID:PGID with mode 0700.
PORT=8888
BIND_ADDRESS=127.0.0.1
CONFIG_DATA=./data
CONTAINER_NAME=timeboardapp
TZ=America/Denver
PUID=1000
PGID=1000
# Required for reset links, GPT Actions, and native MCP. Use your application
# origin, not the static project website. MCP requires HTTPS without a path prefix.
# HTTPS enables Secure session cookies.
TIMEBOARDAPP_BASE_URL=
# Blank preserves mcp.enabled in settings.yml. Set true to enable or false to
# disable MCP explicitly, then recreate the service. MCP is experimental/default-off.
TIMEBOARDAPP_MCP_ENABLED=
